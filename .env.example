# ArqAI CDI Website Environment Variables
# =========================================
# Copy this file to .env.local and fill in your values

# Claude API (Required for intelligent chat responses)
# Get your API key from: https://console.anthropic.com/
# Without this key, the chat will use mock responses (useful for development)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (Required for RAG embeddings)
# Get your API key from: https://platform.openai.com/api-keys
# Uses text-embedding-3-small model for vector embeddings
OPENAI_API_KEY=your_openai_api_key_here

# Weaviate Vector Database (Required for RAG)
# Options:
#   - Weaviate Cloud: https://console.weaviate.cloud/
#   - Self-hosted: docker run -p 8080:8080 semitechnologies/weaviate
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your_weaviate_api_key_here

# Supabase Database (Required for lead storage)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# PostHog Analytics (Optional)
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Email Service (Optional - for lead notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user_here
SMTP_PASSWORD=your_smtp_password_here
NOTIFICATION_EMAIL=sales@thearq.ai

# Site URL
NEXT_PUBLIC_SITE_URL=https://www.thearq.ai

# Dashboard Access (URL-based for V1)
DASHBOARD_SECRET_PATH=your_secret_dashboard_path_here
